        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClaseBase;assembly=ClaseBase"
        Title="ABMUsuarios" Height="450" 
        Width="800" WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True" Loaded="Window_Loaded">
 
        <Window.Resources>
            <ObjectDataProvider
            x:Key="list_usuario"
            ObjectType="{x:Type svc:TrabajarUsuario}"
            MethodName="TraerUsuarios"/>
        </Window.Resources>
