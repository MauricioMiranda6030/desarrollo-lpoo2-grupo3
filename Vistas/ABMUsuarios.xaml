<Window x:Class="Vistas.ABMUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:ClaseBase;assembly=ClaseBase"
        Title="ABMUsuarios" Height="450" 
        Width="800" WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True" Loaded="Window_Loaded">                                       
 
        <Window.Resources>
            <ObjectDataProvider
            x:Key="list_usuario"
            ObjectType="{x:Type svc:TrabajarUsuario}"
            MethodName="TraerUsuarios"/>
        </Window.Resources>

    <Border CornerRadius="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#060531" Offset="0" />
                <GradientStop Color="#1b1448" Offset="0.75" />
            </LinearGradientBrush>
        </Border.Background>
        <Canvas Name="canvas_content" DataContext="{Binding Source={StaticResource ResourceKey=list_usuario}}" Height="266" Width="559">
        <StackPanel Canvas.Left="333" Canvas.Top="45">
            <StackPanel Width="198" Height="102" Margin="0 15 0 0">
                <TextBlock Text="{Binding NombreCompleto}" Height="25" Background="Bisque" Padding="5"/>
                <TextBlock Text="{Binding Nickname}" Height="25" Background="Beige" Padding="5"/>
                <TextBlock Text="{Binding Password}" Height="25" Background="Bisque" Padding="5"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Canvas.Left="12" Canvas.Top="0" Height="39" Width="535">
            <Button  Content="Nuevo" Name="btnNuevo"  Height="30" Width="68" Click="btnNuevo_Click"/>
            <Button  Content="Eliminar" Name="btnEliminar" Margin="0,0,25,0" Height="34" Width="77" Click="btnEliminar_Click" />
            <Button  Content="Cancelar" Name="btnCancelar"  Margin="0,0,25,0" Height="34" Width="67" Click="btnCancelar_Click" />
            <Button  Content="Guardar" Name="btnGuardar"  Height="29" Width="64" Click="btnGuardar_Click" />
            <Button  Content="|&lt;" Name="btnPrimero"  Margin="0 0 10 0" Width="40" Height="23" Click="btnPrimero_Click" />
            <Button  Content="&lt;" Name="btnAnterior"  Margin="0 0 10 0" Width="40" Height="23" Click="btnAnterior_Click" />
            <Button  Content="&gt;" Name="btnSiguiente"   Margin="0 0 10 0" Width="40" Height="23" Click="btnSiguiente_Click" />
            <Button  Content="&gt;|" Name="btnUltimo"  Margin="0 0 10 0" Width="40" Height="23" Click="btnUltimo_Click"/>
        </StackPanel>
                                   
    </Canvas>
    </Border>
    
