    <Border CornerRadius="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                <GradientStop Color="#060531" Offset="0" />
                <GradientStop Color="#1b1448" Offset="0.75" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,164,4" Width="612">
                <Button  Content="Nuevo" Name="btnNuevo" Click="btnNuevo_Click" Height="30" Width="68" />
                <Button  Content="Eliminar" Name="btnEliminar" Margin="0,0,25,0" Click="btnEliminar_Click" Height="34" Width="77" />
                <Button  Content="Cancelar" Name="btnCancelar" Click="btnCancelar_Click" Margin="0,0,25,0" Height="34" Width="67" />
                <Button  Content="Guardar" Name="btnGuardar" Click="btnGuardar_Click" Height="29" Width="64" />
                <Button  Content="|&lt;" Name="btnPrimero" Click="btnPrimero_Click" Margin="0 0 10 0" Width="40" Height="23"/>
                <Button  Content="&lt;" Name="btnAnterior" Click="btnAnterior_Click" Margin="0 0 10 0" Width="40" Height="23" />
                <Button  Content="&gt;" Name="btnSiguiente" Click="btnSiguiente_Click"  Margin="0 0 10 0" Width="40" Height="23"/>
                <Button  Content="&gt;|" Name="btnUltimo" Click="btnUltimo_Click" Margin="0 0 10 0" Width="40" Height="23"/>
            </StackPanel>
            <Grid Width="300" Margin="162,69,314,90" VerticalAlignment="Center" Grid.Row="1" 
                  Name="grid_content" DataContext="{Binding Source={StaticResource ResourceKey=list_usuario}}">
                <Grid.RowDefinitions>
                    
                    
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Label Content="Apellido" Name="label2" Foreground="White" FontSize="14" Margin="6,0,194,0" />
                <TextBox Name="txtApellido" Text="{Binding Apellido}" Margin="100,0,0,0" />
                <Label Grid.Row="2" Content="Nombre" Name="label3" Foreground="White" FontSize="14" Margin="0,0,200,0" />
                <TextBox Grid.Row="2" Name="txtNombre" Text="{Binding Nombre}" Margin="100,0,0,0" />
                <Label Grid.Row="4" Content="User Name" Name="label4" Foreground="White" FontSize="14" Margin="6,0,194,0" />
                <TextBox  Grid.Row="4" Name="txtUserName" Text="{Binding Nickname}" Margin="100,0,0,0" />
                <Label Grid.Row="6" Content="Password" Name="lblPassword" Foreground="White" FontSize="14" Margin="0,0,200,0" />
                <TextBox  Grid.Row="6" Name="txtPassword" Text="{Binding Password}" Margin="100,0,0,0" />
            </Grid>

            
        </Grid>
    </Border>
</Window>
